---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Listening from '@/components/sections/Listening.astro';
import { gardenRadio } from '@/content/home';
---
<BaseLayout title="About — Daisy Hatchet" description="Meet Jeneva, the flower grower and designer behind Daisy Hatchet in Pacifica, California.">
  <section class="about-hero shell" data-about-hero role="button" tabindex="0" aria-label="Show the next About hero image">
    <div class="about-hero__image is-active" aria-hidden="true"></div>
    <div class="about-hero__image about-hero__image--3136" aria-hidden="true"></div>
    <div class="about-hero__image about-hero__image--3170" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow">About Daisy Hatchet</p>
      <h1 class="display">Hello. I’m<br />Jeneva,</h1>
      <p class="hero-line">and I’m a floweraholic.</p>
    </div>
  </section>

  <section class="story shell wave-edge">
    <div class="story-heading">
      <p class="eyebrow">How it started</p>
      <h2 class="display">Two passions,<br />one backyard.</h2>
    </div>
    <div class="story-copy">
      <p class="lead">I’m a stay-at-home mom of two daughters and the founder of Daisy Hatchet.</p>
      <p>Daisy Hatchet was born by combining two passions of mine: gardening and floral design. Given my propensity for being a glutton for punishment, why not do both?</p>
    </div>
  </section>

  <section class="local">
    <div class="local-photo" role="img" aria-label="A vivid seasonal bouquet grown by Daisy Hatchet"></div>
    <div class="local-copy">
      <p class="eyebrow">Pacifica, California</p>
      <h2 class="display">Locally grown by a locally grown local.</h2>
      <div class="details">
        <p>Every flower I offer is grown in bulb crates in my backyard in good ol’ Pacifica, California.</p>
        <p><strong>Why bulb crates?</strong> Because I lack in-ground growing options, yet have ample cement.</p>
        <p>My floral designs have been described as edgy and not pretentious. I don’t take myself too seriously, and my love of pink will definitely shine through.</p>
        <p>My goal is to provide farm-fresh flowers directly to you and to local businesses.</p>
      </div>
    </div>
  </section>

  <Listening {...gardenRadio} />
</BaseLayout>
<script>
  const hero = document.querySelector<HTMLElement>('[data-about-hero]');
  const heroImages = [...document.querySelectorAll<HTMLElement>('.about-hero__image')];
  let currentHeroImage = 0;
  let rotationTimer: number | undefined;
  const showNextHeroImage = () => {
    heroImages[currentHeroImage]?.classList.remove('is-active');
    currentHeroImage = (currentHeroImage + 1) % heroImages.length;
    heroImages[currentHeroImage]?.classList.add('is-active');
  };
  const startRotation = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (rotationTimer !== undefined) window.clearInterval(rotationTimer);
    rotationTimer = window.setInterval(showNextHeroImage, 7000);
  };

  startRotation();

  hero?.addEventListener('click', () => {
    showNextHeroImage();
    startRotation();
  });
  hero?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      showNextHeroImage();
      startRotation();
    }
  });
  window.addEventListener('pagehide', () => {
    if (rotationTimer !== undefined) window.clearInterval(rotationTimer);
  });
</script>
<style>
  .about-hero { position: relative; isolation: isolate; min-height: min(82vh,52rem); display: flex; align-items: end; padding-block: clamp(7rem,12vw,9rem) clamp(4.5rem,8vw,7rem); color: var(--cream); background: #29151f; cursor: pointer; overflow: hidden; }
  .about-hero__image { position: absolute; z-index: 0; inset: 0; background: url('/images/about-hero.jpg') right center / cover no-repeat; opacity: 0; transition: opacity 1.2s ease-in-out; }
  .about-hero__image--3136 { background-image: url('/images/gallery-web/IMG_3136.jpg'); }
  .about-hero__image--3170 { background-image: url('/images/about-hero-3170.jpg'); }
  .about-hero__image.is-active { opacity: 1; }
  .hero-copy { position: relative; z-index: 1; width: 100%; }
  .eyebrow { margin-bottom: 1.5rem; color: var(--chartreuse); }
  h1 { font-size: clamp(5rem,12vw,11rem); line-height: .78; }
  .hero-line { margin: clamp(1.5rem,3vw,2.5rem) 0 0 min(17vw,14rem); color: white; font-size: clamp(1.4rem,3vw,2.4rem); font-weight: 600; }

  .story { --wave-color: var(--cream); display: grid; grid-template-columns: minmax(0,1.15fr) minmax(20rem,.85fr); gap: clamp(3rem,9vw,10rem); align-items: end; padding-block: clamp(7rem,12vw,11rem); background: var(--cream); }
  .story .eyebrow, .local .eyebrow { color: var(--olive); }
  .story h2 { max-width: 10ch; font-size: clamp(4rem,8vw,8rem); }
  .story-copy { display: grid; gap: 1.4rem; color: #604b54; font-size: 1.08rem; }
  .story-copy p { margin: 0; }
  .story-copy .lead { color: var(--ink); font-size: clamp(1.35rem,2.3vw,2rem); font-weight: 600; line-height: 1.3; }

  .local { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(24rem,.95fr); min-height: 48rem; background: white; }
  .local-photo { min-height: 42rem; background: url('/images/gallery-web/IMG_3158.jpg') center / cover no-repeat; }
  .local-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(4rem,8vw,8rem); }
  .local h2 { max-width: 9ch; font-size: clamp(3.4rem,6vw,6.5rem); }
  .details { display: grid; gap: 1.15rem; max-width: 37rem; margin-top: 2.5rem; color: #604b54; }
  .details p { margin: 0; }
  .details strong { color: var(--ink); }

  @media (max-width: 800px) { .story, .local { grid-template-columns: 1fr; } .story { gap: 3rem; } .local-photo { min-height: 65vw; } .local-copy { padding-inline: var(--gutter); } }
  @media (max-width: 520px) { .about-hero { min-height: 42rem; } .hero-line { margin-left: 0; } .local-photo { min-height: 90vw; } }
</style>
