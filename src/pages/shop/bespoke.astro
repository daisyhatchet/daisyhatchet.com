---
import BaseLayout from '@/layouts/BaseLayout.astro';
import palette from '@/content/bespoke-palette.json';
import {SIZES,defaultSize} from '../../../public/editor-assets/bespoke-model.js';
const initialSize = defaultSize(palette.colors);
// Separate silhouettes, with stems belonging to the flowers in each arrangement.
const arrangements = [
  {id:'petite', flowers:[{x:172,y:164,r:-12},{x:237,y:186,r:20},{x:183,y:235,r:8}], leaves:[{x:184,y:285,r:-38},{x:229,y:282,r:35}]},
  {id:'classic', flowers:[{x:110,y:153,r:-10},{x:186,y:106,r:12},{x:282,y:149,r:25},{x:136,y:235,r:5},{x:263,y:234,r:35},{x:205,y:185,r:18}], leaves:[{x:151,y:282,r:-45},{x:252,y:278,r:43},{x:219,y:261,r:25}]},
  {id:'abundant', flowers:[{x:141,y:98,r:-18},{x:228,y:85,r:9},{x:305,y:127,r:25},{x:78,y:168,r:-12},{x:161,y:171,r:18},{x:250,y:162,r:35},{x:324,y:207,r:10},{x:119,y:250,r:22},{x:205,y:244,r:-8},{x:273,y:277,r:30}], leaves:[{x:108,y:287,r:-48},{x:291,y:301,r:50},{x:159,y:310,r:-32},{x:243,y:320,r:36}]},
];
---
<BaseLayout title="Bespoke Bouquet — Daisy Hatchet" description="Your colors. Our seasonal flowers. Build a Bespoke Bouquet in Petite, Classic, or Abundant, from $35.">
<section class="bespoke shell">
<a class="back" href="/shop/">← All flowers</a>
<header class="intro"><p class="eyebrow">A little you. A little wild.</p><h1 class="display">Bespoke<br/><em>bouquet</em></h1><p>You pick the colors. We’ll make them sing.<br/>Seasonal flowers, arranged just for you in Pacifica.</p></header>
{!palette.enabled && <p class="sample-note">A palette in progress — explore sample colors below. Ordering isn’t open yet.</p>}
<div class="workbench">
<aside class="composition" aria-label="Your bouquet palette preview"><div class="paper"><div class="paper-top"><span>DAISY HATCHET</span><span>MADE FOR YOU</span></div>
<div class="flower-art" aria-hidden="true"><svg viewBox="0 0 400 420"><defs><path id="petal" d="M0 -7 C-36 -23 -27 -55 0 -43 C27 -55 36 -23 0 -7Z"/></defs>
{arrangements.map(arrangement=><g data-arrangement={arrangement.id} display={arrangement.id===initialSize.id?'inline':'none'}>
  <g stroke="#72774d" stroke-width="2" fill="none">{arrangement.flowers.map((f,i)=>{
    const bundleX = 211 + (i-(arrangement.flowers.length-1)/2)*.8;
    return <path d={`M${f.x} ${f.y} C${f.x+(bundleX-f.x)*.45} ${f.y+(321-f.y)*.3} ${bundleX} 295 ${bundleX} 321 L${211+(bundleX-211)*2} 355`}/>;
  })}</g>
  <g fill="#8c9568">{arrangement.leaves.map(leaf=><ellipse cx={leaf.x} cy={leaf.y} rx="11" ry="31" transform={`rotate(${leaf.r} ${leaf.x} ${leaf.y})`}/>)}</g>
  {arrangement.flowers.map((f,i)=><g class="bloom" data-bloom={i} transform={`translate(${f.x} ${f.y}) rotate(${f.r})`} fill="#e3d8cd">{[0,60,120,180,240,300].map(r=><use href="#petal" transform={`rotate(${r})`}/>)}<circle r="10" fill="#fffaf4"/><circle r="4" fill="#a49065"/></g>)}
</g>)}
<path d="M186 325 Q210 315 230 325 M211 321 Q176 300 181 318 Q184 332 211 321 Q244 302 239 321 Q232 333 211 321 L196 349 M211 321 L228 344" stroke="#b77b89" stroke-width="3" fill="none"/></svg></div>
<div class="paper-bottom"><p id="art-title">Your {initialSize.name}</p><div id="palette-ribbon" aria-hidden="true"></div><p id="art-caption">A blank canvas. Make it yours.</p></div></div>
<p class="art-note">A little color study, not an exact bouquet.<br/>Nature chooses the flowers; you set the mood.</p></aside>
<div class="choices"><fieldset class="sizes"><legend><span>01</span> Choose your abundance</legend><div class="size-options">{SIZES.map(size=><label class="size-option"><input type="radio" name="size" value={size.id} checked={size.id===initialSize.id}/><span class="size-card"><strong>{size.name}</strong><span class="size-price">${size.price}</span><small data-size-help={size.id}>{size.min}–{size.max} colors</small></span></label>)}</div><p id="size-story">{initialSize.description}</p></fieldset>
<div class="palette-stage">
<button type="button" class="mini-preview" id="mini-preview" aria-label="Enlarge your bouquet preview" aria-haspopup="dialog" hidden><span id="mini-art" aria-hidden="true"></span><span class="mini-copy"><strong id="mini-title">Your {initialSize.name}</strong><span id="mini-dots" aria-hidden="true"></span><span id="mini-count">0 of {initialSize.max} colors</span><span class="mini-hint">Take a closer look ↗</span></span></button>
<fieldset class="color-field"><legend><span>02</span> Find your color story</legend><div class="palette-help"><p id="color-instruction">Pick {initialSize.min}–{initialSize.max} colors. Trust your eye.</p><span id="color-count">0 selected</span></div><div class="swatches">{palette.colors.map(c=><button type="button" class="swatch" data-color={c.id} aria-pressed="false" disabled={!c.available} aria-label={`${c.name}${c.available?'':' — unavailable'}`}><span class="paint" style={`--swatch:${c.hex}`}><span class="check">✓</span></span><span>{c.name}</span>{!c.available&&<small>Resting for now</small>}</button>)}</div><p id="palette-feedback" role="status" aria-live="polite">Choose {initialSize.min} more colors to complete your {initialSize.name}.</p><button class="reset" id="clear-colors" type="button" hidden>Start a fresh palette ↺</button></fieldset></div>
<section class="review" aria-labelledby="review-title"><div class="review-heading"><h2 id="review-title">Your little masterpiece</h2><p id="summary-price">${initialSize.price}</p></div><p id="summary-size">{initialSize.name} · Bespoke Bouquet</p><div id="chosen-colors">No colors chosen yet.</div><p class="design-note">We’ll compose your colors with the best of what’s growing. Flower varieties and exact shades vary with the season.</p><button class="button" id="bouquet-checkout" disabled>Choose your colors</button><p id="checkout-feedback" role="status" aria-live="polite"></p><p class="checkout-small">Porch pickup or $10 local delivery.<br/>Delivery eligibility is confirmed at checkout.</p></section></div></div>
<section class="closing-note"><span aria-hidden="true">✳</span><h2>A bouquet with your name on it.</h2><p>No two gardens, days, or people are quite the same.<br/>Your flowers shouldn’t be either.</p></section><noscript>Please enable JavaScript to customize your bouquet.</noscript>
<dialog id="preview-dialog" aria-labelledby="preview-dialog-title"><form method="dialog"><button class="preview-close" aria-label="Close bouquet preview">×</button></form><h2 id="preview-dialog-title">Your color study</h2><div id="expanded-art" aria-hidden="true"></div><p id="expanded-caption"></p><p class="art-note">Nature chooses the flowers; you set the mood.</p></dialog>
</section></BaseLayout>
<script src="../../scripts/bespoke.ts"></script>
<style>
.bespoke{padding-block:2.5rem 5rem}.back{font-size:.82rem;text-decoration:none}.intro{text-align:center;padding:3rem 0 2rem}.intro .eyebrow{color:var(--olive)}h1{font-size:clamp(4rem,8.4vw,8rem);margin:1.3rem 0 1.7rem}h1 em{font-style:normal;color:#b43862}.intro>p:last-child{color:#6a5359;font-size:1.05rem}.sample-note{text-align:center;padding:.7rem 1rem;background:#eee6f1;border-radius:.5rem;font-size:.83rem;margin:0 auto 2rem;max-width:70rem}.workbench{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(2rem,6vw,7rem);max-width:76rem;margin:auto;align-items:start}.composition{position:sticky;top:7rem;padding:1.5rem;background:#e7ebdb;border-radius:48% 48% .5rem .5rem}.paper{margin:1.2rem .4rem .5rem;padding:1.4rem;background:#fffdf5;box-shadow:0 12px 25px #38422812;transform:rotate(-3deg);border:1px solid #f0ebdf}.paper-top{display:flex;justify-content:space-between;gap:1rem;font-size:.56rem;letter-spacing:.16em}.flower-art svg{width:100%;height:auto;display:block}.bloom{transition:fill .4s}.paper-bottom{text-align:center;min-height:6.5rem}#art-title{font-family:var(--heading);font-size:1.7rem;margin:0 0 .7rem}#art-caption{font-size:.72rem;margin:.6rem 0 0;color:#6a5359}#palette-ribbon{display:flex;justify-content:center;gap:.3rem}#palette-ribbon :global(span){width:1.6rem;height:.5rem;border-radius:2px}.art-note{text-align:center;font-size:.73rem;line-height:1.6;margin:1.6rem 0 .5rem;color:#526044}fieldset{padding:0;border:0;margin:0 0 2rem;min-width:0}legend{font-size:1.24rem;font-weight:600;margin:0 0 1.3rem;letter-spacing:-.035em}legend>span{display:inline-flex;align-items:center;justify-content:center;width:1.8rem;height:1.8rem;border:1px solid #cbbdc0;border-radius:50%;font-size:.65rem;letter-spacing:0;margin-right:.6rem;vertical-align:middle}.size-options{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}.size-option{position:relative;cursor:pointer}.size-option input{position:absolute;opacity:0;width:1px;height:1px}.size-card{display:grid;padding:1.1rem .6rem;border:1px solid #d8cbd0;border-radius:.5rem;text-align:center;transition:background .2s,border-color .2s}.size-card strong{font-weight:500}.size-price{font-size:1.7rem;margin:.15rem 0}.size-card small{font-size:.7rem;color:#6a5359}.size-option input:checked+.size-card{background:#f8dce6;border:2px solid #9b395a;padding:calc(1.1rem - 1px) calc(.6rem - 1px)}.size-option input:focus-visible+.size-card{outline:3px solid #9b395a;outline-offset:4px}#size-story{font-size:.82rem;color:#6a5359;margin:.75rem 0 0}.palette-help{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;font-size:.78rem;margin-bottom:1.2rem}.palette-help p{margin:0}#color-count{white-space:nowrap;color:#6a5359}.swatches{display:flex;flex-wrap:wrap;justify-content:center;gap:1.15rem .7rem}.swatches>.swatch{flex:0 0 calc((100% - 2.1rem)/4)}.swatch{border:0;background:none;padding:0;display:flex;align-items:center;flex-direction:column;cursor:pointer;font-size:.72rem;gap:.45rem;color:var(--ink);min-height:6.3rem}.paint{display:grid;place-items:center;width:clamp(2.75rem,5vw,4rem);aspect-ratio:1;border-radius:50% 46% 47% 44%;background:var(--swatch);border:1px solid #29151f15;outline:2px solid transparent;outline-offset:4px;transition:transform .2s,outline .2s}.swatch:hover .paint{transform:rotate(10deg) scale(1.05)}.swatch[aria-pressed=true] .paint{outline-color:var(--ink)}.check{display:none;background:var(--cream);border-radius:50%;width:1.25rem;height:1.25rem;font-size:.8rem;line-height:1.25rem}.swatch[aria-pressed=true] .check{display:block}.swatch:disabled{cursor:default;color:#78696f}.swatch:disabled .paint{opacity:.4;background:linear-gradient(135deg,transparent 48%,#fffaf4 49%,#fffaf4 52%,transparent 53%),var(--swatch)}.swatch small{font-size:.59rem;margin-top:-.3rem}.swatch:focus-visible{outline:2px solid #9b395a;outline-offset:6px;border-radius:.3rem}#palette-feedback{min-height:2.8em;margin:1.25rem 0 .2rem;font-size:.83rem;color:#78415a}.reset{padding:.4rem 0;border:0;border-bottom:1px solid #b9a7ae;background:none;font-size:.76rem;cursor:pointer}.review{padding:1.5rem;border:1px solid #dacdd1;border-radius:.65rem;background:#fffdf9}.review-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem}.review h2{font-size:1.1rem;margin:0;font-weight:500;letter-spacing:-.03em}#summary-price{font-size:1.5rem;margin:0}#summary-size{font-size:.75rem;color:#6a5359;margin:.3rem 0 1rem}#chosen-colors{display:flex;flex-wrap:wrap;gap:.4rem;font-size:.8rem;min-height:2rem}#chosen-colors :global(.color-chip){border:1px solid #d4c0c9;border-radius:99px;padding:.3rem .7rem;background:#f7edf0;font-size:.72rem;cursor:pointer;color:var(--ink)}.design-note{font-size:.78rem;color:#6a5359;line-height:1.65;margin:1rem 0}.review .button{width:100%;font-size:.76rem}.button:disabled{background:#e6dbdf;color:#6b565e;border-color:#e6dbdf;cursor:default;transform:none}#checkout-feedback{font-size:.8rem;color:#8b2344;margin:.8rem 0 0}#checkout-feedback:empty{display:none}.checkout-small{text-align:center;font-size:.68rem;color:#6a5359;margin:.8rem 0 0}.closing-note{text-align:center;margin-top:6rem}.closing-note>span{color:#b43862;font-size:3rem}.closing-note h2{font-size:clamp(1.5rem,3vw,2.5rem);font-family:var(--heading);font-weight:400;margin:.5rem 0}.closing-note p{font-size:.9rem;color:#6a5359}[hidden]{display:none!important}button:focus-visible{outline:3px solid #9b395a;outline-offset:3px}
.mini-preview{display:none}#preview-dialog{width:min(90vw,26rem);max-height:85dvh;overflow:auto;border:1px solid #d8cbd0;border-radius:1rem;padding:1.5rem;background:#fffdf5;color:var(--ink);text-align:center}#preview-dialog::backdrop{background:#29151f80}#preview-dialog h2{font-family:var(--heading);font-weight:400;margin:.5rem 2rem;font-size:1.8rem}.preview-close{float:right;border:0;background:none;font-size:2rem;min-width:44px;min-height:44px;cursor:pointer;color:var(--ink)}#expanded-art :global(svg){display:block;width:100%;max-height:45dvh}#expanded-caption{font-size:.85rem}body:has(#preview-dialog[open]){overflow:hidden}
@media(max-width:760px){.mini-preview{opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-12px);transition:opacity .2s ease,transform .24s ease,visibility 0s linear .24s;position:fixed;top:var(--bouquet-header-height,76px);z-index:5;display:flex;align-items:center;gap:.8rem;width:100%;height:124px;margin:0 0 1.5rem;padding:.35rem 1rem;border:1px solid #d7ddc8;border-radius:0 0 .65rem .65rem;border-top:0;background:#eff1e5;box-shadow:0 5px 15px #29151f10;text-align:left;color:var(--ink);cursor:pointer}.mini-preview.is-visible{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0);transition-delay:0s}.mini-copy{display:grid;gap:.3rem}.mini-copy strong{font-family:var(--heading);font-size:1.3rem;font-weight:400}.mini-copy>span{font-size:.7rem}.mini-hint{color:#78415a}#mini-art{width:106px;flex:none}#mini-art :global(svg){display:block;width:100%;height:112px}#mini-dots{display:flex;gap:.3rem}#mini-dots:empty{display:none}#mini-dots :global(span){width:.8rem;height:.8rem;border-radius:50%;border:1px solid #29151f20}.swatch,.size-option{scroll-margin-top:calc(var(--bouquet-header-height,76px) + 140px)}.palette-stage{display:flow-root}}
@media(max-width:760px){.bespoke{padding-top:1.5rem}.intro{padding-top:2.2rem}.intro h1{font-size:clamp(3.7rem,13vw,6rem)}.workbench{grid-template-columns:1fr;gap:2.5rem}.composition{position:relative;top:auto;max-width:26rem;width:100%;margin:auto;padding:.7rem 1.5rem}.paper{max-width:20rem;margin:.6rem auto;padding:1rem}.flower-art svg{max-height:230px}.paper-bottom{min-height:5rem}.art-note{margin:1rem 0 .5rem}.paint{width:3.4rem}.choices{max-width:36rem;width:100%;margin:auto}.closing-note{margin-top:3rem}.intro>p:last-child{font-size:.9rem}.size-card strong{font-size:.88rem}}
@media(max-width:360px){.mini-copy strong{font-size:1.05rem}#mini-art{width:90px}.mini-preview{gap:.6rem;padding-inline:.65rem}}
@media(prefers-reduced-motion:reduce){.mini-preview{transition:none;transform:none}}
</style>
