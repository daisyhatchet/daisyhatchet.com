---
import BaseLayout from '@/layouts/BaseLayout.astro';

const files = [
  '0C8DE050-4C61-4E11-A4F5-619A3AAAC557_1_102_o.jpeg', '16425611-C32D-47D3-ACA6-71CE5AA4D6B7_1_102_o.jpeg',
  '1B8EF10D-6CA8-4CE2-84AB-6899F9BDF499_4_5005_c.jpeg', '1CAB7A3D-D5A1-4BBD-9692-33895E34B8B4_4_5005_c.jpeg',
  '1E038482-AF7F-4F10-83D9-41FD174CF37F_4_5005_c.jpeg', '40854DBC-2EBC-4F73-81D4-3C57A03BAA5C_1_102_o.jpeg',
  '47C9AC05-7481-4405-AB4A-DE891C5B4295_1_105_c.jpeg', '4D69AD7C-C369-484E-982E-A56C09E1EE53_1_105_c.jpeg',
  '5084153C-20A5-41A0-A0B0-19925F44D69E_4_5005_c.jpeg', '54688A6D-47A2-482E-B98C-FD3B43718C2E_1_105_c.jpeg',
  '5B13D5F1-459F-46C2-875A-A20CA2DE8BD1_4_5005_c.jpeg', '69D321A9-8FB9-4F61-83AE-BE48304804E6_1_105_c.jpeg',
  '6FE0EDB9-7597-45AD-858C-AB6FD6CB0B54_4_5005_c.jpeg', '74A85A2F-193D-4831-85F0-7F36FD48AC65_4_5005_c.jpeg',
  '8897776A-5A57-43D9-9E1B-23C116C2A1F1_1_105_c.jpeg', 'A7BCF4EA-462E-405E-A7B7-B5A7EAEE63B6_4_5005_c.jpeg',
  'A9655376-F121-40B4-B32D-05598228F10A_4_5005_c.jpeg', 'B237D834-728B-43A2-8F9E-34215063122A_4_5005_c.jpeg',
  'BCD07B7C-ACF7-41EB-94A4-4F8D9C4DAC5B_4_5005_c.jpeg', 'C4B23E3D-0BF0-4527-92D5-DD6C62ACCE33_1_105_c.jpeg',
  'D1551071-72E1-4E1C-9334-B8D78D1CEC22_1_105_c.jpeg', 'D8F7D39C-FE51-4FB6-8F05-40789350B935_1_105_c.jpeg',
  'D963556E-C248-417E-9ECB-A98A6ECCE769_4_5005_c.jpeg', 'E02AA096-1D97-46F0-BE6B-FE34A53E2BAA_1_105_c.jpeg',
  'E150F5B0-772E-4DBD-A175-E6F433FD74C7_4_5005_c.jpeg', 'FA0F802F-4299-424C-AE2E-CAB30FF21EBD_4_5005_c.jpeg',
];
const cropRatios = ['3 / 4', '1 / 1', '4 / 5', '5 / 6', '4 / 3', '2 / 3', '6 / 7'];
const cropPositions = ['50% 50%', '50% 38%', '50% 62%', '40% 50%', '60% 46%', '46% 42%'];
const photos = files.map((file, i) => ({
  src: `/images/gallery-web/${file}`,
  alt: `Seasonal flowers from Daisy Hatchet, photograph ${i + 1}`,
  caption: `Field note ${String(i + 1).padStart(2, '0')}`,
  width: file.startsWith('74A85A2F') ? 480 : 768,
  height: file.startsWith('74A85A2F') ? 360 : 1024,
  cropRatio: file.startsWith('74A85A2F') ? '4 / 3' : cropRatios[(i * 3) % cropRatios.length],
  cropPosition: cropPositions[(i * 2) % cropPositions.length],
}));
---
<BaseLayout title="Gallery — Daisy Hatchet" description="A look at the flowers growing at Daisy Hatchet in Pacifica, California.">
  <main class="gallery shell">
    <header>
      <div><p class="eyebrow">From the field</p><h1 class="display">Cuttings.</h1></div>
      <p class="intro">A changing collection of flowers, arrangements, and small moments from the growing season.</p>
    </header>
    <div class="masonry">
      {photos.map((photo, i) => (
        <figure class="tile">
          <div class="image-wrap">
            <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading={i < 4 ? 'eager' : 'lazy'} style={`--crop-ratio: ${photo.cropRatio}; --crop-position: ${photo.cropPosition}`} />
          </div>
          <figcaption><span>{String(i + 1).padStart(2, '0')}</span><span>{photo.caption}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="gallery-end"><span>Fresh cuts added seasonally</span><a href="https://instagram.com/daisy_hatchet_flowers/" target="_blank" rel="noreferrer">Follow along on Instagram ↗</a></div>
  </main>
</BaseLayout>
<style>
  .gallery { --max: 104rem; padding-block: clamp(5rem,10vw,9rem); background: var(--cream); }
  header { display: grid; grid-template-columns: minmax(0,1fr) minmax(18rem,.42fr); align-items: end; gap: 3rem; margin-bottom: clamp(4rem,8vw,7rem); }
  .eyebrow { margin-bottom: 1.25rem; color: var(--olive); }
  h1 { font-size: clamp(5rem,13vw,12rem); }
  .intro { max-width: 29rem; margin: 0 0 .9rem; color: #604b54; font-size: clamp(1rem,1.5vw,1.2rem); }
  .masonry { columns: 4; column-gap: clamp(1rem,2vw,2rem); }
  .tile { break-inside: avoid; margin: 0 0 clamp(2rem,4vw,3.5rem); }
  .image-wrap { overflow: hidden; background: #eadfe3; }
  img { width: 100%; aspect-ratio: var(--crop-ratio); object-fit: cover; object-position: var(--crop-position); transition: transform .7s cubic-bezier(.22,.8,.3,1); }
  .tile:hover img { transform: scale(1.025); }
  figcaption { display: flex; justify-content: space-between; gap: 1rem; padding-top: .8rem; color: #604b54; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }
  .gallery-end { display: flex; justify-content: space-between; gap: 2rem; margin-top: clamp(2rem,5vw,5rem); padding-top: 1.4rem; border-top: 1px solid #d7cbd0; color: #604b54; font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .gallery-end a { color: var(--pink); text-decoration: none; }
  @media (max-width: 1050px) { header { grid-template-columns: 1fr; gap: 1.5rem; } .masonry { columns: 3; } }
  @media (max-width: 680px) { .masonry { columns: 2; } }
  @media (max-width: 460px) { header { grid-template-columns: 1fr; gap: 1.5rem; } .masonry { columns: 1; } .gallery-end { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { img { transition: none; } }
</style>
