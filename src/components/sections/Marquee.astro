---
interface Props { items: string[]; }
const { items } = Astro.props;
---
<div class="marquee" aria-label={items.join(', ')}>
  <div aria-hidden="true">{[...items, ...items].map((item) => <span>{item}&nbsp; ✦ &nbsp;</span>)}</div>
</div>
<style>
  .marquee { overflow: hidden; color: var(--ink); background: var(--chartreuse); }
  .marquee div { display: flex; width: max-content; padding-block: 1.1rem; animation: crawl 25s linear infinite; }
  span { font: 400 clamp(2.2rem,4vw,4rem)/.85 var(--heading); letter-spacing: -.025em; white-space: nowrap; }
  @keyframes crawl { to { transform: translateX(-50%); } }
</style>
