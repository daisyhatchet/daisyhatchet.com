---
interface Props { title: string; body: string; link?: { label: string; href: string }; }
const { title, body, link } = Astro.props;
---
<section class="statement shell">
  <h2 class="display">{title}</h2>
  <p>{body}</p>
  {link && <a class="button" href={link.href}>{link.label}</a>}
</section>
<style>
  .statement { min-height: 72vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem; padding-block: 6rem; color: var(--lime); background: var(--pink); text-align: center; }
  h2 { max-width: 11ch; font-size: clamp(4.8rem, 12vw, 11rem); }
  p { max-width: 42ch; margin: 0; color: var(--ink); font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.4; }
</style>

