---
interface Props {
  title: string;
  body: string;
  playlistId: string;
}

const { title, body, playlistId } = Astro.props;
const embedUrl = `https://open.spotify.com/embed/playlist/${encodeURIComponent(playlistId)}?utm_source=generator&theme=0`;
---

<section class="listening shell wave-edge" aria-labelledby="listening-title">
  <div class="listening__copy">
    <p class="eyebrow">Garden radio</p>
    <h2 class="display" id="listening-title">{title}</h2>
    <p>{body}</p>
  </div>

  <div class="listening__player">
    <iframe
      title="Spotify garden playlist"
      src={embedUrl}
      width="100%"
      height="352"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
    ></iframe>
  </div>
</section>

<style>
  .listening {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(22rem, 1.15fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 10rem);
    padding-block: clamp(6rem, 11vw, 10rem);
    background: var(--blush);
  }
  .listening__copy { max-width: 35rem; }
  .eyebrow { margin-bottom: 1.5rem; color: var(--olive); }
  h2 { max-width: 7ch; font-size: clamp(4rem, 8vw, 7.5rem); }
  .listening__copy > p:last-child { max-width: 29rem; margin: 2rem 0 0; color: #604b54; font-size: 1.08rem; }
  .listening__player { position: relative; padding: clamp(.65rem, 1.5vw, 1rem); background: var(--pink); border-radius: 1.5rem; box-shadow: 0 1.5rem 3.5rem rgb(79 28 54 / 18%); transform: rotate(1deg); }
  iframe { display: block; border: 0; border-radius: 1rem; }
  @media (max-width: 760px) {
    .listening { grid-template-columns: 1fr; gap: 2.5rem; }
    .listening__player { transform: none; }
    h2 { font-size: clamp(3.5rem, 18vw, 6rem); }
  }
</style>
