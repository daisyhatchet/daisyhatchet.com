---
interface Props { kicker: string; title: string; body: string; image?: string; }
const { kicker, title, body, image = '/images/daisy-hatchet-mark.webp' } = Astro.props;
---
<section class="hero shell">
  <div class="hero__copy">
    <p class="eyebrow">{kicker}</p>
    <h1 class="display">{title}</h1>
    <p>{body}</p>
    <a href="#season" class="button">See what’s growing</a>
  </div>
  <div class="hero__art">
    <img src={image} alt="A black and white drawing of a daisy crossing over a hatchet" width="900" height="900" fetchpriority="high" />
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 761px)');
  let framePending = false;

  const updateParallax = () => {
    framePending = false;
    if (!hero || reducedMotion.matches || !desktop.matches) {
      hero?.style.setProperty('--parallax-y', '0px');
      return;
    }
    const bounds = hero.getBoundingClientRect();
    const shift = Math.max(0, Math.min(-bounds.top * .4, hero.offsetHeight * .3));
    hero.style.setProperty('--parallax-y', `${shift}px`);
  };

  const requestParallaxUpdate = () => {
    if (framePending) return;
    framePending = true;
    requestAnimationFrame(updateParallax);
  };

  updateParallax();
  window.addEventListener('scroll', requestParallaxUpdate, { passive: true });
  window.addEventListener('resize', requestParallaxUpdate);
</script>
<style>
  .hero { --parallax-y: 0px; position: relative; isolation: isolate; height: 100svh; max-height: 100svh; display: flex; align-items: center; padding-block: clamp(6.5rem,10vw,8rem) clamp(2.5rem,5vw,5rem); color: var(--cream); background: #76204e; overflow: hidden; }
  .hero::before, .hero::after { content: ''; position: absolute; pointer-events: none; }
  .hero::before { z-index: -2; inset: -20% -6%; background: url('/images/field.webp') center 44% / cover no-repeat; transform: translate3d(0,var(--parallax-y),0) scale(1.04); will-change: transform; }
  .hero::after { z-index: -1; inset: 0; background: linear-gradient(rgba(172,34,105,.34),rgba(118,31,78,.44)); }
  .hero__copy { position: relative; z-index: 1; width: min(58%,49rem); container-type: inline-size; }
  .eyebrow { margin-bottom: 1.6rem; color: var(--chartreuse); }
  h1 { max-width: 14ch; font-size: clamp(3.4rem,5vw,5.25rem); }
  .hero__copy > p:not(.eyebrow) { max-width: 31rem; margin-block: 2rem; font-size: clamp(1.05rem,1.7vw,1.35rem); }
  .hero__copy > p:not(.eyebrow) { color: var(--cream); text-shadow: 0 1px 18px rgba(104,24,65,.42); }
  .hero__art { position: absolute; z-index: 0; top: 50%; left: 66.666%; width: clamp(48rem,70vw,82rem); transform: translate(-50%,-50%); pointer-events: none; }
  .hero__art img { width: 100%; aspect-ratio: 1; object-fit: contain; filter: invert(1); opacity: .42; }
  .button { color: var(--ink); background: var(--chartreuse); border-color: var(--chartreuse); }
  @media (max-width: 760px) { .hero { height: auto; max-height: none; min-height: 100svh; padding-top: 10.5rem; overflow: hidden; } .hero__copy { width: 100%; } .hero__art { left: 72%; width: min(145vw,50rem); } h1 { font-size: clamp(2.4rem,13.5cqi,6.5rem); } }
  @media (prefers-reduced-motion: reduce) { .hero::before { transform: scale(1.04); } }
</style>
