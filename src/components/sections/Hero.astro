---
interface Props { kicker: string; title: string; body: string; image?: string; }
const { kicker, title, body, image = '/images/hero.jpg' } = Astro.props;
---
<section class="hero shell">
  <div class="hero__copy">
    <p class="eyebrow">{kicker}</p>
    <h1 class="display">{title}</h1>
    <p class="intro">{body}</p>
    <a class="button" href="#season">What’s growin’ ↓</a>
  </div>
  <figure>
    <img src={image} alt="A bold arrangement of locally grown seasonal flowers" width="1200" height="800" fetchpriority="high" />
    <figcaption>Grown in Pacifica · cut by hand</figcaption>
  </figure>
</section>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); min-height: calc(100svh - 86px); padding-block: var(--gutter); gap: var(--gutter); background: var(--orange); border-bottom: var(--line); }
  .hero__copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  h1 { max-width: 8ch; margin-block: 1.2rem 1.5rem; font-size: clamp(4rem, 9vw, 9rem); }
  .intro { max-width: 40ch; font: italic clamp(1.25rem, 2vw, 1.8rem)/1.25 var(--serif); }
  .button { margin-top: 1.2rem; }
  figure { position: relative; margin: 0; min-height: 65vh; border: var(--line); overflow: hidden; background: var(--ink); }
  figure::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, transparent 60%, rgba(212,255,0,.28)); mix-blend-mode: screen; pointer-events: none; }
  img { height: 100%; object-fit: cover; filter: saturate(1.12) contrast(1.05); }
  figcaption { position: absolute; inset: auto 1rem 1rem auto; padding: .45rem .65rem; background: var(--paper); border: 1px solid var(--ink); font-size: .65rem; text-transform: uppercase; }
  @media (max-width: 800px) { .hero { grid-template-columns: 1fr; } figure { min-height: 55vh; order: -1; } h1 { font-size: clamp(3.7rem, 18vw, 7rem); } }
</style>
