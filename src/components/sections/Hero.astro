---
interface Props { kicker: string; title: string; body: string; image?: string; }
const { kicker, title, body, image = '/images/daisy-hatchet-mark.webp' } = Astro.props;
---
<section class="hero shell">
  <p class="hero__top">{title}</p>
  <img src={image} alt="A black and white drawing of a daisy crossing over a hatchet" width="900" height="900" fetchpriority="high" />
  <p class="hero__bottom">{body}<br /><span>{kicker}</span></p>
</section>
<style>
  .hero { min-height: calc(100svh - 86px); display: flex; flex-direction: column; align-items: center; justify-content: center; padding-block: clamp(3rem, 7vw, 6rem); text-align: center; background: var(--pink); }
  .hero__top { margin: 0 0 2.5rem; color: var(--lime); font-size: clamp(1.7rem, 3vw, 2.4rem); }
  img { width: min(44vw, 34rem); height: min(44vw, 34rem); object-fit: contain; mix-blend-mode: multiply; }
  .hero__bottom { margin: 1rem 0 0; color: var(--lavender); font-size: clamp(1.45rem, 2.5vw, 2rem); line-height: 1.18; }
  @media (max-width: 650px) { .hero { min-height: 78svh; } img { width: min(88vw, 30rem); height: min(88vw, 30rem); } }
</style>

