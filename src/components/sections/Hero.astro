---
interface Props { kicker: string; title: string; body: string; image?: string; }
const { kicker, title, body, image = '/images/daisy-hatchet-mark.webp' } = Astro.props;
---
<section class="hero shell">
  <div class="hero__copy">
    <p class="eyebrow">{kicker}</p>
    <h1 class="display">{title}</h1>
    <p>{body}</p>
    <a href="#season" class="button">See what’s growing</a>
  </div>
  <div class="hero__art">
    <img src={image} alt="A black and white drawing of a daisy crossing over a hatchet" width="900" height="900" fetchpriority="high" />
  </div>
</section>
<style>
  .hero { min-height: calc(100svh - 88px); display: grid; grid-template-columns: minmax(0,1.3fr) minmax(15rem,.5fr); align-items: center; gap: clamp(2rem,7vw,8rem); padding-block: clamp(3rem,7vw,7rem); color: var(--cream); background: linear-gradient(rgba(172,34,105,.48),rgba(118,31,78,.58)), url('/images/field.webp') center 44% / cover no-repeat; }
  .hero__copy { max-width: 49rem; }
  .eyebrow { margin-bottom: 1.6rem; color: var(--chartreuse); }
  h1 { max-width: 14ch; font-size: clamp(3.4rem,5vw,5.25rem); }
  .hero__copy > p:not(.eyebrow) { max-width: 31rem; margin-block: 2rem; font-size: clamp(1.05rem,1.7vw,1.35rem); }
  .hero__copy > p:not(.eyebrow) { color: var(--cream); text-shadow: 0 1px 18px rgba(104,24,65,.42); }
  .hero__art { position: relative; padding: clamp(.5rem,2vw,1.5rem); }
  .hero__art img { width: 100%; aspect-ratio: 1; object-fit: contain; filter: invert(1); opacity: .94; }
  .button { color: var(--ink); background: var(--chartreuse); border-color: var(--chartreuse); }
  @media (max-width: 760px) { .hero { grid-template-columns: 1fr; } .hero__art { width: min(85vw,28rem); margin-inline: auto; order: -1; } h1 { font-size: clamp(4rem,18vw,7rem); } }
</style>
