---
interface Props { kicker: string; title: string; body: string; image?: string; }
const { kicker, title, body, image = '/images/daisy-hatchet-mark.webp' } = Astro.props;
---
<section class="hero shell">
  <div class="hero__copy">
    <p class="eyebrow">{kicker}</p>
    <h1 class="display">{title}</h1>
    <p>{body}</p>
    <a href="#season" class="button">See what’s growing</a>
  </div>
  <div class="hero__art">
    <img src={image} alt="A black and white drawing of a daisy crossing over a hatchet" width="900" height="900" fetchpriority="high" />
  </div>
</section>
<style>
  .hero { position: relative; isolation: isolate; height: calc(100svh - 88px); max-height: calc(100svh - 88px); display: flex; align-items: center; padding-block: clamp(2.5rem,5vw,5rem); color: var(--cream); background: linear-gradient(rgba(172,34,105,.34),rgba(118,31,78,.44)), url('/images/field.webp') center 44% / cover no-repeat; overflow: hidden; }
  .hero__copy { position: relative; z-index: 1; width: min(58%,49rem); }
  .eyebrow { margin-bottom: 1.6rem; color: var(--chartreuse); }
  h1 { max-width: 14ch; font-size: clamp(3.4rem,5vw,5.25rem); }
  .hero__copy > p:not(.eyebrow) { max-width: 31rem; margin-block: 2rem; font-size: clamp(1.05rem,1.7vw,1.35rem); }
  .hero__copy > p:not(.eyebrow) { color: var(--cream); text-shadow: 0 1px 18px rgba(104,24,65,.42); }
  .hero__art { position: absolute; z-index: 0; top: 50%; right: clamp(-18rem,-13vw,-8rem); width: clamp(48rem,70vw,82rem); transform: translateY(-50%); pointer-events: none; }
  .hero__art img { width: 100%; aspect-ratio: 1; object-fit: contain; filter: invert(1); opacity: .42; }
  .button { color: var(--ink); background: var(--chartreuse); border-color: var(--chartreuse); }
  @media (min-width: 761px) and (prefers-reduced-motion: no-preference) { .hero { background-attachment: fixed; } }
  @media (max-width: 760px) { .hero { height: auto; max-height: none; min-height: calc(100svh - 9rem); overflow: hidden; } .hero__copy { width: 100%; } .hero__art { right: -48vw; width: min(145vw,50rem); } h1 { font-size: clamp(3.6rem,16vw,6.5rem); } }
</style>
