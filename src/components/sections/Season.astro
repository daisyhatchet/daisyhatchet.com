---
interface Props { title: string; current: string[]; soon: string[]; note: string; }
const { title, current, soon, note } = Astro.props;
---
<section class="season shell" id="season">
  <header>
    <p class="eyebrow">Field notes · right now</p>
    <h2 class="display">{title}</h2>
    <p class="intro">{note}</p>
  </header>
  <div class="lists">
    <article><p class="number">01</p><h3>Currently Blooming</h3><ul>{current.map((flower) => <li>{flower}</li>)}</ul></article>
    <article><p class="number">02</p><h3>Blooming Soon</h3><ul>{soon.map((flower) => <li>{flower}</li>)}</ul></article>
  </div>
</section>
<style>
  .season { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(24rem,.85fr); gap: clamp(3rem,8vw,9rem); padding-block: clamp(6rem,12vw,11rem); background: var(--cream); }
  header { position: sticky; top: 2rem; align-self: start; }
  .eyebrow { margin-bottom: 1.5rem; color: var(--olive); }
  h2 { max-width: 8ch; font-size: clamp(4.5rem,10vw,9.5rem); }
  .intro { max-width: 32rem; margin-top: 2rem; color: #604b54; font-size: 1.1rem; }
  .lists { display: grid; gap: 1rem; }
  article { padding: clamp(1.6rem,3vw,2.5rem); border-radius: 1.2rem; }
  article:first-child { background: var(--chartreuse); }
  article:last-child { background: var(--blush); }
  .number { margin: 0 0 2rem; font-size: .75rem; letter-spacing: .12em; }
  h3 { margin: 0 0 1.5rem; font: 750 clamp(1.8rem,3vw,2.7rem)/1 var(--heading); letter-spacing: -.035em; }
  ul { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; margin: 0; padding: 0; list-style: none; }
  li { padding-block: .62rem; border-top: 1px solid rgba(41,21,31,.3); font-size: .96rem; }
  @media (max-width: 800px) { .season { grid-template-columns: 1fr; } header { position: static; } ul { grid-template-columns: 1fr; } }
</style>

