---
interface Props { title: string; current: string[]; soon: string[]; note: string; }
const { title, current, soon, note } = Astro.props;
---
<section class="season shell" id="season">
  <div class="season__title">
    <p class="eyebrow">Field notes · right now</p>
    <h2 class="display">{title}</h2>
    <p class="note">{note}</p>
  </div>
  <div class="list current">
    <h3>Currently blooming</h3>
    <ul>{current.map((flower, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{flower}</li>)}</ul>
  </div>
  <div class="list soon">
    <h3>Coming up</h3>
    <ul>{soon.map((flower, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{flower}</li>)}</ul>
  </div>
</section>
<style>
  .season { display: grid; grid-template-columns: 1.2fr 1fr 1fr; border-bottom: var(--line); padding-block: clamp(4rem, 9vw, 8rem); }
  .season__title { padding-right: var(--gutter); }
  h2 { margin-block: 1rem 2rem; font-size: clamp(4rem, 9vw, 9rem); }
  .note { max-width: 34ch; font: italic 1.3rem/1.3 var(--serif); }
  .list { padding-inline: var(--gutter); border-left: var(--line); }
  h3 { margin: 0 0 2rem; font: 1rem/1 var(--display); text-transform: uppercase; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 3rem 1fr; padding-block: .75rem; border-top: 1px solid var(--ink); font-size: clamp(1rem, 1.5vw, 1.2rem); }
  li span { font-size: .65rem; opacity: .6; }
  .current { background: var(--paper); }
  .soon { background: var(--pink); }
  @media (max-width: 850px) { .season { grid-template-columns: 1fr 1fr; } .season__title { grid-column: 1 / -1; padding-bottom: 3rem; } .list:first-of-type { border-left: 0; padding-left: 0; } }
  @media (max-width: 560px) { .season { grid-template-columns: 1fr; } .list { padding: 2rem 0; border: 0; border-top: var(--line); } }
</style>
