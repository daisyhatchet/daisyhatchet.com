---
const path = Astro.url.pathname;
const links = [{ href: '/about', label: 'About' }, { href: '/gallery', label: 'Gallery' }];
---
<header class="site-header shell">
  <a class="wordmark" href="/" aria-label="Daisy Hatchet home">DAISY HATCHET</a>
  <nav aria-label="Main navigation">
    {links.map(({ href, label }) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
  </nav>
  <a class="instagram" href="https://instagram.com/daisy_hatchet_flowers/" target="_blank" rel="noreferrer" aria-label="Daisy Hatchet on Instagram">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
  </a>
</header>
<style>
  .site-header { position: relative; z-index: 10; min-height: 86px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; background: var(--pink); }
  .wordmark { font-family: var(--heading); font-size: clamp(2rem, 4vw, 3.15rem); line-height: .8; text-decoration: none; white-space: nowrap; }
  nav { display: flex; gap: clamp(1.2rem, 2.5vw, 2.4rem); }
  nav a { font-size: clamp(1.2rem, 2vw, 1.55rem); text-decoration: none; }
  nav a:hover, nav a[aria-current] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .instagram { width: 2.8rem; height: 2.8rem; display: grid; place-items: center; color: var(--pink); background: var(--ink); border-radius: .45rem; }
  .instagram svg { width: 1.75rem; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .instagram svg circle:last-child { fill: currentColor; stroke: none; }
  @media (max-width: 650px) { .site-header { grid-template-columns: 1fr auto; gap: .8rem; padding-block: 1rem; } nav { grid-row: 2; grid-column: 1 / -1; } .wordmark { font-size: clamp(2rem, 11vw, 3rem); } }
</style>

