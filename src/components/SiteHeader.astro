---
const path = Astro.url.pathname;
const links = [{ href: '/about', label: 'About' }, { href: '/gallery', label: 'Gallery' }];
---
<header class="site-header shell">
  <a class="wordmark" href="/" aria-label="Daisy Hatchet home">DAISY HATCHET</a>
  <nav aria-label="Main navigation">
    {links.map(({ href, label }) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    <a href="https://instagram.com/daisy_hatchet_flowers/" target="_blank" rel="noreferrer">Instagram ↗</a>
  </nav>
</header>
<style>
  .site-header { position: relative; z-index: 10; min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; color: var(--cream); background: var(--ink); }
  .wordmark { font-family: var(--brand); font-size: clamp(1.9rem, 3.5vw, 3rem); line-height: .8; text-decoration: none; white-space: nowrap; }
  nav { display: flex; gap: clamp(1rem, 2.5vw, 2.2rem); align-items: center; }
  nav a { font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; }
  nav a:hover, nav a[aria-current] { color: var(--chartreuse); }
  @media (max-width: 650px) { .site-header { min-height: auto; align-items: flex-start; padding-block: 1.15rem; flex-direction: column; gap: 1rem; } nav { width: 100%; justify-content: space-between; } }
</style>

