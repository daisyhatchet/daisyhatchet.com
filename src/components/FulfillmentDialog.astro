---
import {DELIVERY_WINDOWS, NOTE_LIMIT} from '@/lib/delivery.mjs';
---
<dialog id="fulfillment-dialog" aria-labelledby="fulfillment-title">
  <form method="dialog" novalidate>
    <button class="fulfillment-close" value="cancel" formnovalidate aria-label="Close">×</button>
    <p class="eyebrow">Almost there</p>
    <h2 id="fulfillment-title">How should your flowers find you?</h2>
    <fieldset class="methods">
      <legend class="visually-hidden">Pickup or delivery</legend>
      <label class="method"><input type="radio" name="method" value="pickup" /><span><strong>Porch pickup</strong><small>Free in Pacifica · usually ready the next day</small></span></label>
      <label class="method"><input type="radio" name="method" value="delivery" /><span><strong>Local delivery · $10</strong><small>Pacifica, Daly City, Montara, Moss Beach, El Granada &amp; Half Moon Bay</small></span></label>
    </fieldset>
    <div class="delivery-fields" hidden>
      <label class="field">Delivery day <select name="day"></select></label>
      <fieldset class="windows">
        <legend>Delivery window</legend>
        <div>{DELIVERY_WINDOWS.map(window => <label><input type="radio" name="window" value={window} /><span>{window}</span></label>)}</div>
      </fieldset>
      <p class="hint">We deliver weekdays between 10am and 4pm.</p>
    </div>
    <label class="field note">Anything we should know? <span>Optional</span><textarea name="note" rows="3" maxlength={NOTE_LIMIT} placeholder="Gate code, where to leave them, it’s a surprise…"></textarea></label>
    <p class="fulfillment-error" role="alert"></p>
    <button class="button" value="continue">Continue to checkout ↗</button>
    <p class="fulfillment-small">You’ll add your address and payment with Shopify next.</p>
  </form>
</dialog>
<style>
  #fulfillment-dialog { width: min(32rem, calc(100vw - 1.5rem)); max-height: calc(100dvh - 1.5rem); overflow: auto; padding: 0; border: 0; border-radius: 1rem; background: var(--cream); color: var(--ink); box-shadow: 0 2rem 6rem rgb(0 0 0 / 30%); }
  #fulfillment-dialog::backdrop { background: rgb(30 14 23 / 75%); backdrop-filter: blur(5px); }
  #fulfillment-dialog[open] { animation: fulfillment-in 240ms cubic-bezier(.2,.8,.2,1) both; }
  @keyframes fulfillment-in { from { opacity: 0; transform: translateY(10px) scale(.98); } }
  :global(body:has(#fulfillment-dialog[open])) { overflow: hidden; }
  form { padding: 2rem clamp(1.25rem, 5vw, 2.25rem) 1.75rem; }
  .eyebrow { font-size: .68rem; margin: 0 0 .75rem; color: var(--olive); }
  h2 { font-family: var(--heading); font-weight: 400; font-size: clamp(1.7rem, 6vw, 2.2rem); line-height: 1.1; margin: 0 2.5rem 1.4rem 0; }
  .fulfillment-close { float: right; width: 2.75rem; height: 2.75rem; margin: -.75rem -.5rem 0 .5rem; border: 1px solid #d9ced1; border-radius: 50%; background: var(--cream); color: var(--ink); font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .fulfillment-close:hover { background: var(--ink); color: var(--cream); }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .methods { display: grid; gap: .6rem; }
  .method { position: relative; cursor: pointer; }
  input[type=radio] { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .method span { display: grid; gap: .2rem; padding: .9rem 1rem; border: 1px solid #d8cbd0; border-radius: .6rem; background: #fffdf9; transition: background .2s, border-color .2s; }
  .method strong { font-weight: 600; font-size: .95rem; }
  .method small { color: #6a5359; font-size: .76rem; line-height: 1.5; }
  .method input:checked + span, .windows input:checked + span { background: #f8dce6; border-color: #9b395a; box-shadow: inset 0 0 0 1px #9b395a; }
  .method input:focus-visible + span, .windows input:focus-visible + span { outline: 3px solid #9b395a; outline-offset: 3px; }
  .delivery-fields { display: grid; gap: 1rem; margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid #e3d8db; }
  .field { display: grid; gap: .45rem; font-size: .85rem; font-weight: 600; }
  .field > span { font-weight: 400; color: #6a5359; font-size: .75rem; margin-top: -.4rem; }
  select, textarea { width: 100%; padding: .7rem .8rem; border: 1px solid #cdbfc4; border-radius: .5rem; background: #fffdf9; color: var(--ink); font: inherit; font-weight: 400; font-size: 1rem; }
  textarea { resize: vertical; min-height: 4.5rem; }
  select:focus-visible, textarea:focus-visible { outline: 3px solid #9b395a; outline-offset: 2px; }
  .windows legend { font-size: .85rem; font-weight: 600; margin-bottom: .45rem; }
  .windows div { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .windows label { position: relative; cursor: pointer; }
  .windows span { display: block; padding: .75rem .3rem; border: 1px solid #d8cbd0; border-radius: .5rem; background: #fffdf9; text-align: center; font-size: .8rem; white-space: nowrap; transition: background .2s, border-color .2s; }
  .hint { margin: -.3rem 0 0; color: #6a5359; font-size: .75rem; }
  .note { margin-top: 1.25rem; }
  .fulfillment-error { margin: .9rem 0 0; color: #8b2344; font-size: .85rem; }
  .fulfillment-error:empty { display: none; }
  .button { width: 100%; margin-top: 1.25rem; }
  .fulfillment-small { margin: .7rem 0 0; text-align: center; color: #6a5359; font-size: .72rem; }
  [hidden] { display: none !important; }
  @media (max-width: 340px) { .windows div { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { #fulfillment-dialog[open] { animation: none; } }
</style>
